# Site
NEXT_PUBLIC_SITE_URL=https://www.planory.net

# --- Email lead magnets (PDF) ---
# Provider : resend (défaut si clé présente) | brevo
# Prod : domaine d’envoi vérifié chez le provider, ex. Planory <noreply@planory.net>
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
CONTACT_EMAIL_FROM=Planory <noreply@planory.net>

# Notifications équipe lead magnets (virgules ou point-virgules)
LEAD_MAGNET_NOTIFICATION_RECIPIENTS=william.tran@planory.net,clementdeobaldia@gmail.com
# Legacy (toujours lu en secours si LEAD_MAGNET_* est vide)
# CONTACT_FORM_RECIPIENTS=william.tran@planory.net,clementdeobaldia@gmail.com

# Rate-limit partagé (optionnel, multi-instances Vercel) — https://console.upstash.com
# Sans ces variables : limite en mémoire par instance
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Profils marque (sameAs) — laisser vide tant que les URLs ne sont pas confirmées
# NEXT_PUBLIC_BRAND_LINKEDIN_URL=
# NEXT_PUBLIC_BRAND_G2_URL=
# NEXT_PUBLIC_BRAND_CAPTERRA_URL=

# Site
NEXT_PUBLIC_SITE_URL=https://www.planory.net

# Analytics (Postgres) — run sql/analytics_events.sql, then sql/admin_users.sql
# (both idempotent: re-run them after an update to apply new columns/tables)
DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# ANALYTICS_ENVIRONMENT=production

# Admin dashboard (/admin) — JWT cookie session
ADMIN_JWT_SECRET=
# Bootstrap (npm run admin:seed reads .env / .env.local) — remove these after seeding, never commit them
# ADMIN_SEED_EMAIL_1=
# ADMIN_SEED_PASSWORD_1=
# ADMIN_SEED_EMAIL_2=
# ADMIN_SEED_PASSWORD_2=

# E-mails (Resend) — lead magnets + dashboard login codes. Required in production: without it
# no admin can log in (in development the code is printed in the server console instead).
# RESEND_API_KEY=
# CONTACT_EMAIL_FROM=Planory <contact@planory.net>

# Google Search Console in the dashboard (service account with "Restricted" access to the property)
# GSC_SITE_URL=sc-domain:planory.net
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Lead magnets → Google Sheets (URL Apps Script Web App)
GOOGLE_SHEETS_WEBHOOK_URL=
# Optionnel — doit correspondre à SCRIPT_SECRET dans tools/google-apps-script-lead-magnet.gs
# GOOGLE_SHEETS_WEBHOOK_SECRET=

# Rate-limit partagé (optionnel, multi-instances) — https://console.upstash.com
# Sans ces variables : limite en mémoire par instance
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Profils marque (sameAs) — laisser vide tant que les URLs ne sont pas confirmées
# NEXT_PUBLIC_BRAND_LINKEDIN_URL=
# NEXT_PUBLIC_BRAND_G2_URL=
# NEXT_PUBLIC_BRAND_CAPTERRA_URL=

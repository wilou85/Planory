{
  "name": "planory-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run lead-magnets:pdf && npm run sitemap:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:invariants": "vitest run src/lib/test/invariants.test.ts",
    "validate:responsive": "node tools/responsive-validate.mjs",
    "seo:competitors": "node tools/competitor-keyword-research.mjs",
    "lead-magnets:pdf": "node tools/generate-lead-magnet-pdfs.mjs",
    "leads:ehpad": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/finess-ehpad-leads.mjs",
    "admin:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tools/seed-admin.mjs",
    "sitemap:generate": "vitest run src/lib/sitemap-generate.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.42.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.21.0",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "lighthouse": "^12.8.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  }
}
